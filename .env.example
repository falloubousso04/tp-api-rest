# Copier ce fichier en .env puis remplacer les marqueurs <...> par des valeurs locales.
# Le fichier .env est exclu du suivi Git. Spring Boot ne le lit PAS automatiquement :
# chargez-le dans le terminal avec scripts/load-env.ps1 (Windows) ou scripts/load-env.sh.

# --- Connexion PostgreSQL (rôle applicatif, jamais le compte d'administration) ---
DB_URL=jdbc:postgresql://localhost:5432/tp_rest
DB_USERNAME=tp_api
DB_PASSWORD=<mot_de_passe_local_a_definir>

# --- JWT ---
# Clé de 32 octets aléatoires minimum, encodée en Base64 : scripts/generate-jwt-secret.ps1 (ou .sh)
JWT_SECRET_BASE64=<cle_base64_generee_localement>
# Durée de validité des tokens en secondes (900 = 15 minutes)
JWT_TTL_SECONDS=900

# --- Profil d'exécution ---
SPRING_PROFILES_ACTIVE=tp

# --- Initialisation du premier ADMIN (uniquement le temps du démarrage avec le profil bootstrap) ---
# Décommenter, démarrer avec SPRING_PROFILES_ACTIVE=tp,bootstrap, puis recommenter / supprimer.
# BOOTSTRAP_ADMIN_NAME=Administrateur
# BOOTSTRAP_ADMIN_EMAIL=admin@exemple.test
# BOOTSTRAP_ADMIN_PASSWORD=<mot_de_passe_admin_a_definir>

# --- Optionnel : mot de passe du compte d'administration du conteneur PostgreSQL (compose.yaml) ---
# Utilisé par Docker Compose uniquement, jamais par l'application.
# POSTGRES_ADMIN_PASSWORD=<mot_de_passe_admin_postgres_a_definir>
